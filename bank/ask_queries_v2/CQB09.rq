# cq_id=CQB09 class=deterministic source=bank/ask_queries/CQB09.rq
# addendum16 standardization: Brick-vocabulary query kept verbatim except the `a` verb written as rdf:type;
# predicate rewriting (step 7) is applied at run time from harness/real_run/ask_alignment_v2/predicate_map.csv, never in this file.
PREFIX brick: <https://brickschema.org/schema/Brick#>
PREFIX rec: <https://w3id.org/rec#>
PREFIX ref: <https://brickschema.org/schema/Brick/ref#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

ASK {
  {
    SELECT (COUNT(DISTINCT ?c) AS ?n) WHERE { ?c rdfs:subClassOf brick:Equipment }
  }
  FILTER(?n = 24)
  FILTER EXISTS { brick:Electrical_Equipment rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:HVAC_Equipment rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Lighting_Equipment rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Meter rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Motor rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Valve rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Furniture rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Camera rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Elevator rdfs:subClassOf brick:Equipment }
  FILTER EXISTS { brick:Tank rdfs:subClassOf brick:Equipment }
}
