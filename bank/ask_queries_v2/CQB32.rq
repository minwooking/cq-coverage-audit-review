# cq_id=CQB32 class=deterministic source=bank/ask_queries/CQB32.rq
# addendum16 standardization: Brick-vocabulary query kept verbatim except the `a` verb written as rdf:type;
# predicate rewriting (step 7) is applied at run time from harness/real_run/ask_alignment_v2/predicate_map.csv, never in this file.
PREFIX brick: <https://brickschema.org/schema/Brick#>
PREFIX rec: <https://w3id.org/rec#>
PREFIX ref: <https://brickschema.org/schema/Brick/ref#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

ASK {
  FILTER EXISTS { { brick:deprecation ?p1 ?o1 } UNION { ?s1 brick:deprecation ?o2 } UNION { ?s2 ?p2 brick:deprecation } }
  FILTER EXISTS { { brick:isReplacedBy ?p3 ?o3 } UNION { ?s3 brick:isReplacedBy ?o4 } UNION { ?s4 ?p4 brick:isReplacedBy } }
  FILTER EXISTS { { brick:deprecationMitigationRule ?p5 ?o5 } UNION { ?s5 brick:deprecationMitigationRule ?o6 } UNION { ?s6 ?p6 brick:deprecationMitigationRule } }
}
