# cq_id=CQB12 class=deterministic source=bank/ask_queries/CQB12.rq
# addendum16 standardization: Brick-vocabulary query kept verbatim except the `a` verb written as rdf:type;
# predicate rewriting (step 7) is applied at run time from harness/real_run/ask_alignment_v2/predicate_map.csv, never in this file.
PREFIX brick: <https://brickschema.org/schema/Brick#>
PREFIX rec: <https://w3id.org/rec#>
PREFIX ref: <https://brickschema.org/schema/Brick/ref#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

ASK {
  FILTER NOT EXISTS {
    ?c rdfs:subClassOf brick:Location .
    FILTER(?c NOT IN (brick:Building, brick:Floor, brick:Outdoor_Area, brick:Outside, brick:Region, brick:Site, brick:Space, brick:Storey, brick:Wing, brick:Zone))
  }
  FILTER EXISTS { brick:Building rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Floor rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Outdoor_Area rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Outside rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Region rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Site rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Space rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Storey rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Wing rdfs:subClassOf brick:Location }
  FILTER EXISTS { brick:Zone rdfs:subClassOf brick:Location }
}
