PREFIX brick: <https://brickschema.org/schema/Brick#>
PREFIX rec: <https://w3id.org/rec#>
PREFIX ref: <https://brickschema.org/schema/Brick/ref#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX qudt: <http://qudt.org/schema/qudt/>

ASK {
  {
    SELECT (COUNT(DISTINCT ?c) AS ?n) WHERE { ?c rdfs:subClassOf brick:Electrical_Equipment }
  }
  FILTER(?n = 10)
  FILTER EXISTS { brick:Breaker_Panel rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Bus_Riser rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Electric_Vehicle_Charging_Port rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Electric_Vehicle_Charging_Station rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Energy_Storage rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Inverter rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Motor_Control_Center rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:PlugStrip rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Switchgear rdfs:subClassOf brick:Electrical_Equipment }
  FILTER EXISTS { brick:Transformer rdfs:subClassOf brick:Electrical_Equipment }
}
