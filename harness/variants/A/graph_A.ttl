ex:AngularVelocityObservation a owl:Class ;
    rdfs:label "Angular velocity observation" ;
    rdfs:subClassOf ex:ObservationEvent .

ex:Apartment a owl:Class ;
    rdfs:label "Apartment" ;
    rdfs:subClassOf ex:Collection .

ex:Apparent_EnergyQuantityShape a owl:Class ;
    rdfs:label "Apparent EnergyQuantityShape" ;
    rdfs:subClassOf ex:ValueShape .

ex:ArchitectureArea a owl:Class ;
    rdfs:label "Architecture area" ;
    rdfs:comment "Describes business-relevant area measurements typically associated with architected spaces. As the exact requirements on these measurements will vary from case to case or jurisdiction to jurisdiction, subclassing and specializing this definition is encouraged." ;
    rdfs:subClassOf ex:Information .

ex:ArchitectureCapacity a owl:Class ;
    rdfs:label "Architecture capacity" ;
    rdfs:comment "Describes business-relevant capacity measurements typically associated with architected spaces. As the exact requirements on these measurements will vary from case to case or jurisdiction to jurisdiction, subclassing and specializing this definition is encouraged." ;
    rdfs:subClassOf ex:Information .

ex:AreaObservation a owl:Class ;
    rdfs:label "Area observation" ;
    rdfs:subClassOf ex:ObservationEvent .

ex:AreaShape a owl:Class ;
    rdfs:label "AreaShape" ;
    rdfs:subClassOf ex:ValueShape .

ex:Atrium a owl:Class ;
    rdfs:label "Atrium" ;
    rdfs:subClassOf ex:Common_Space,
        ex:Room ;
    owl:definition "a large open-air or skylight covered space surrounded by a building" .

ex:AudioVisualEquipment a owl:Class ;
    rdfs:label "Audio Visual Equipment" ;
    rdfs:comment "Audio visual equipment." ;
    rdfs:subClassOf ex:ICTEquipment .

ex:Audio_Visual_Equipment a owl:Class ;
    rdfs:label "Audio Visual Equipment" ;
    rdfs:subClassOf ex:ICT_Equipment ;
    owl:definition "Equipment related to sound and visual components such as speakers and displays" .

ex:Auditorium a owl:Class ;
    rdfs:label "Auditorium" ;
    rdfs:subClassOf ex:Common_Space,
        ex:Room ;
