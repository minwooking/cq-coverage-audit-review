@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:AED a owl:Class ;
    rdfs:label "AED" ;
    rdfs:subClassOf ex:Safety_Equipment .

ex:AHU a owl:Class ;
    rdfs:label "AHU" ;
    rdfs:subClassOf ex:HVAC_Equipment ;
    owl:definition "Assembly consisting of sections containing a fan or fans and other necessary equipment to perform one or more of the following functions: circulating, filtration, heating, cooling, heat recovery, humidifying, dehumidifying, and mixing of air. Is usually connected to an air-distribution system." .

ex:Ablutions_Room a owl:Class ;
    rdfs:label "Ablutions Room" ;
    rdfs:subClassOf ex:Room ;
    owl:definition "A room for performing cleansing rituals before prayer" .

ex:AbsoluteHumidityObservation a owl:Class ;
    rdfs:label "Absolute humidity observation" ;
    rdfs:subClassOf ex:ObservationEvent .

ex:Absolute_Humidity_Sensor a owl:Class ;
    rdfs:label "Absolute Humidity Sensor" ;
    rdfs:subClassOf ex:Humidity_Sensor ;
    owl:definition "Measures the present state of absolute humidity" .

ex:Absorption_Chiller a owl:Class ;
    rdfs:label "Absorption Chiller" ;
    rdfs:subClassOf ex:Chiller ;
    owl:definition "A chiller that utilizes a thermal or/and chemical process to produce the refrigeration effect necessary to provide chilled water. There is no mechanical compression of the refrigerant taking place within the machine, as occurs within more traditional vapor compression type chillers." .

ex:AccelerationObservation a owl:Class ;
    rdfs:label "Acceleration observation" ;
    rdfs:subClassOf ex:ObservationEvent .

ex:Acceleration_Time_Setpoint a owl:Class ;
    rdfs:label "Acceleration Time Setpoint" ;
    rdfs:subClassOf ex:Time_Setpoint .

ex:AccessControlZone a owl:Class ;
    rdfs:label "Access control zone" ;
    rdfs:subClassOf ex:Zone .

ex:AccessPanel a owl:Class ;
    rdfs:label "Access panel" ;
    rdfs:subClassOf ex:BarrierAsset .

ex:Access_Reader a owl:Class ;
    rdfs:label "Access Reader" ;
    rdfs:subClassOf ex:Access_Control_Equipment .

ex:Active_Chilled_Beam a owl:Class ;
    rdfs:label "Active Chilled Beam" ;
    rdfs:subClassOf ex:Chilled_Beam ;
    owl:definition "A Chilled Beam with an integral primary air connection that induces air flow through the device." .

ex:Active_EnergyQuantityShape a owl:Class ;
    rdfs:label "Active EnergyQuantityShape" ;
    rdfs:subClassOf ex:ValueShape .

ex:Active_Power_Sensor a owl:Class ;
    rdfs:label "Active Power Sensor" ;
    rdfs:subClassOf ex:Electric_Power_Sensor ;
    owl:definition "Measures the portion of power that, averaged over a complete cycle of the AC waveform, results in net transfer of energy in one direction" .

ex:ActuationEvent a owl:Class ;
    rdfs:label "Actuation event" ;
    rdfs:subClassOf ex:PointEvent .

ex:AdmittingRoom a owl:Class ;
    rdfs:label "Admitting room" ;
    rdfs:subClassOf ex:HealthcareRoom .

ex:AggregationShape a owl:Class ;
    rdfs:label "AggregationShape" ;
    rdfs:subClassOf ex:ValueShape .

ex:Air_Cooled_Chiller a owl:Class ;
    rdfs:label "Air Cooled Chiller" ;
    rdfs:subClassOf ex:Chiller ;
    owl:definition "A chiller that uses air to cool the refrigerant, used in various commercial and industrial cooling applications" .

ex:Air_Flow_Loss_Alarm a owl:Class ;
    rdfs:label "Air Flow Loss Alarm" ;
    rdfs:subClassOf ex:Air_Flow_Alarm ;
    owl:definition "An alarm that indicates loss in air flow." .

ex:Air_Handler_Unit a owl:Class ;
    rdfs:label "Air Handler Unit" ;
