    skos:definition "Measures the rate of flow in a hot water circuit" .

ex:Max_Air_Flow_Setpoint_Limit a owl:Class ;
    rdfs:label "Max Air Flow Setpoint Limit" ;
    rdfs:subClassOf ex:Air_Flow_Setpoint_Limit,
        ex:Max_Limit ;
    skos:definition "A parameter that places an upper bound on the range of permitted values of a Air_Flow_Setpoint." .

ex:Min_Air_Flow_Setpoint_Limit a owl:Class ;
    rdfs:label "Min Air Flow Setpoint Limit" ;
    rdfs:subClassOf ex:Air_Flow_Setpoint_Limit,
        ex:Min_Limit ;
    owl:definition "A parameter that places a lower bound on the range of permitted values of a Air_Flow_Setpoint." .

ex:Outside_Air_Temperature_Setpoint a owl:Class ;
    rdfs:label "Outside Air Temperature Setpoint" ;
    rdfs:subClassOf ex:Air_Temperature_Setpoint ;
    skos:definition "Sets temperature of outside air" .

ex:Switchgear a owl:Class ;
    rdfs:label "Switchgear" ;
    rdfs:subClassOf ex:Electrical_Equipment ;
    owl:comment "A main disconnect or service disconnect feeds power to a switchgear, which then distributes power to the rest of the building through smaller amperage-rated disconnects." .

ex:Table a owl:Class ;
    rdfs:label "Table" ;
    rdfs:subClassOf ex:Furniture .

ex:Water_Alarm a owl:Class ;
    rdfs:label "Water Alarm" ;
    rdfs:subClassOf ex:Alarm ;
    owl:definition "Alarm that indicates an undesirable event with a pipe, container, or equipment carrying water e.g. water leak" .

ex:Water_Storage_Tank a owl:Class ;
    rdfs:label "Water Storage Tank" ;
    rdfs:subClassOf ex:Storage_Tank ;
    owl:definition "A specialized type of tank intended for the storage of water for extended periods." .

ex:Zone_Air_Temperature_Setpoint a owl:Class ;
    rdfs:label "Zone Air Temperature Setpoint" ;
    rdfs:subClassOf ex:Air_Temperature_Setpoint ;
    owl:definition "Sets temperature of zone air" .

ex:hasDefinition a owl:DatatypeProperty ;
    rdfs:label "has definition" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ex:Air_Flow_Setpoint a owl:Class ;
    rdfs:label "Air Flow Setpoint" ;
    rdfs:subClassOf ex:Flow_Setpoint ;
    owl:definition "Sets air flow" .

ex:Common_Space a owl:Class ;
    rdfs:label "Common Space" ;
    rdfs:subClassOf ex:Space .

ex:Dewpoint_Sensor a owl:Class ;
    rdfs:label "Dewpoint Sensor" ;
    rdfs:subClassOf ex:Sensor ;
    owl:definition "Senses the dewpoint temperature . Dew point is the temperature to which air must be cooled to become saturated with water vapor" .

ex:Differential_Setpoint a owl:Class ;
    rdfs:label "Differential Setpoint" ;
    rdfs:subClassOf ex:Setpoint ;
    owl:comment "A type of Setpoints that is related to the difference between two measurements" .

ex:ExternalReference a owl:Class ;
    rdfs:label "External reference" ;
    rdfs:subClassOf <http://data.ashrae.org/standard223#ExternalReference> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://data.ashrae.org/standard223#ExternalReference> [ a owl:Restriction ;
                        owl:hasValue "The parent class of all external reference types"^^xsd:string ;
                        owl:onProperty ex:hasDefinition ] ) ] .

ex:Fire_Safety_Equipment a owl:Class ;
    rdfs:label "Fire Safety Equipment" ;
    rdfs:subClassOf ex:Equipment ;
    owl:definition "" .

ex:FoodHandlingRoom a owl:Class ;
    rdfs:label "Food-handling room" ;
    rdfs:subClassOf ex:Room .

ex:Integral_Time_Parameter a owl:Class ;
    rdfs:label "Integral Time Parameter" ;
    rdfs:subClassOf ex:Time_Parameter .

ex:Leaving_Water_Temperature_Setpoint a owl:Class ;
    rdfs:label "Leaving Water Temperature Setpoint" ;
    rdfs:subClassOf ex:Water_Temperature_Setpoint ;
    skos:definition "Sets temperature of leaving water" .

ex:Meter a owl:Class ;
    rdfs:label "Meter" ;
    rdfs:subClassOf ex:Equipment ;
    owl:definition "A device that measure usage or consumption of some media --- typically a form energy or power." .

ex:On_Off_Command a owl:Class ;
    rdfs:label "On Off Command" ;
    rdfs:subClassOf ex:Command ;
    skos:definition "An On/Off Command controls or reports the binary status of a control loop, relay or equipment activity" .

ex:Point a owl:Class ;
    rdfs:label "Point" ;
    rdfs:subClassOf ex:Class,
        ex:Entity,
        ex:Geometry .

ex:Pressure_Sensor a owl:Class ;
    rdfs:label "Pressure Sensor" ;
    rdfs:subClassOf ex:Sensor ;
    skos:definition "Measure the amount of force acting on a unit area" .

ex:Radiant_Panel a owl:Class ;
    rdfs:label "Radiant Panel" ;
    rdfs:subClassOf ex:Terminal_Unit ;
    owl:definition "A temperature-controlled surface that provides fifty percent (50%) or more of the design heat transfer by thermal radiation." .

ex:Start_Stop_Status a owl:Class ;
    rdfs:label "Start Stop Status" ;
    rdfs:comment "Indicates the active/inactive status of a control loop (but not equipment activities or relays -- use On/Off for this purpose)" ;
    rdfs:subClassOf ex:On_Off_Status .

ex:Supply_Water_Temperature_Sensor a owl:Class ;
    rdfs:label "Supply Water Temperature Sensor" ;
    rdfs:subClassOf ex:Water_Temperature_Sensor .

ex:Temperature_High_Reset_Setpoint a owl:Class ;
    rdfs:label "Temperature High Reset Setpoint" ;
    rdfs:subClassOf ex:Reset_Setpoint .

ex:Temperature_Low_Reset_Setpoint a owl:Class ;
    rdfs:label "Temperature Low Reset Setpoint" ;
    rdfs:subClassOf ex:Reset_Setpoint .

ex:UtilitiesRoom a owl:Class ;
    rdfs:label "Utilities room" ;
    rdfs:subClassOf ex:Room .

ex:Water_Valve a owl:Class ;
    rdfs:label "Water Valve" ;
    rdfs:subClassOf ex:Valve ;
    owl:definition "A valve that modulates the flow of water" .

ex:Architecture a owl:Class ;
    rdfs:label "Architecture" ;
    rdfs:comment "A designed/landscaped (or potentially designed/landscaped) part of the physical world that has a 3D spatial extent. E.g., a building site, a building, levels within the building, rooms, etc." ;
    rdfs:subClassOf ex:Space .

ex:Chilled_Water_Temperature_Sensor a owl:Class ;
    rdfs:label "Chilled Water Temperature Sensor" ;
    rdfs:comment "Measures the temperature of chilled water" ;
    rdfs:subClassOf ex:Water_Temperature_Sensor .

ex:ICT_Equipment a owl:Class ;
    rdfs:label "ICT Equipment" ;
    rdfs:subClassOf ex:Equipment ;
    owl:definition "Information and Communications Technology (ICT) equipment operates with a processor to process data or logic and create digital signals." .

ex:On_Off_Status a owl:Class ;
    rdfs:label "On Off Status" ;
    rdfs:subClassOf ex:Off_Status,
        ex:On_Status,
        ex:Status ;
    skos:definition "Indicates the on/off status of a control loop, relay or equipment" .

ex:Proportional_Band_Parameter a owl:Class ;
    rdfs:label "Proportional Band Parameter" ;
    rdfs:subClassOf ex:PID_Parameter .

ex:Relative_Humidity_Sensor a owl:Class ;
    rdfs:label "Relative Humidity Sensor" ;
    rdfs:subClassOf ex:Humidity_Sensor ;
    owl:definition "Measures the present state of absolute humidity relative to a maximum humidity given the same temperature" .

ex:Temperature_Setpoint a owl:Class ;
    rdfs:label "Temperature Setpoint" ;
    rdfs:subClassOf ex:Setpoint ;
    owl:definition "Sets temperature" .

ex:Zone a owl:Class ;
    rdfs:label "Zone" ;
    rdfs:subClassOf ex:Architecture,
        ex:Location ;
    owl:definition "(1) a separately controlled heated or cooled space. (2) one occupied space or several occupied spaces with similar occupancy category, occupant density, zone air distribution effectiveness, and zone primary airflow per unit area. (3) space or group of spaces within a building for which the heating, cooling, or lighting requirements are sufficiently similar that desired conditions can be maintained throughout by a single controlling device." .

ex:Air_Flow_Sensor a owl:Class ;
    rdfs:label "Air Flow Sensor" ;
    rdfs:subClassOf ex:Flow_Sensor ;
    owl:definition "Measures the rate of flow of air" .

ex:Cooling_Temperature_Setpoint a owl:Class ;
    rdfs:label "Cooling Temperature Setpoint" ;
    rdfs:subClassOf ex:Temperature_Setpoint ;
    owl:definition "Sets temperature for cooling" .

ex:Entity a owl:Class ;
    rdfs:label "Entity" .

ex:Mode_Status a owl:Class ;
    rdfs:label "Mode Status" ;
    rdfs:subClassOf ex:Status ;
    owl:equivalentClass ex:Mode_Status .

ex:Parameter a owl:Class ;
    rdfs:label "Parameter" ;
    rdfs:subClassOf ex:Point ;
    owl:definition "Parameter points are configuration settings used to guide the operation of equipment and control systems; for example they may provide bounds on valid setpoint values" .

ex:Sensor_Equipment a owl:Class ;
    rdfs:label "Sensor Equipment" ;
    rdfs:subClassOf ex:ICT_Equipment ;
    skos:definition "A piece of equipment for sensing some physical properties" .

ex:Temperature_Deadband_Setpoint a owl:Class ;
    rdfs:label "Temperature Deadband Setpoint" ;
    rdfs:subClassOf ex:Deadband_Setpoint,
        ex:Temperature_Setpoint ;
    owl:comment "Sets the size of a deadband of temperature" .

ex:Temperature_Sensor a owl:Class ;
    rdfs:label "Temperature Sensor" ;
    rdfs:subClassOf ex:Sensor ;
    owl:definition "Measures temperature: the physical property of matter that quantitatively expresses the common notions of hot and cold" .

ex:Water_Flow_Setpoint a owl:Class ;
    rdfs:label "Water Flow Setpoint" ;
    rdfs:subClassOf ex:Flow_Setpoint ;
    owl:definition "Sets the target flow rate of water" .

ex:Water_Temperature_Setpoint a owl:Class ;
    rdfs:label "Water Temperature Setpoint" ;
    rdfs:subClassOf ex:Temperature_Setpoint ;
    owl:definition "Sets temperature of water" .

ex:Air_Quality_Sensor a owl:Class ;
    rdfs:label "Air Quality Sensor" ;
    rdfs:subClassOf ex:Sensor ;
    owl:definition "A sensor which provides a measure of air quality" .

ex:Damper a owl:Class ;
    rdfs:label "Damper" ;
    rdfs:subClassOf ex:HVAC_Equipment ;
    owl:definition "Element inserted into an air-distribution system or element of an air-distribution system permitting modification of the air resistance of the system and consequently changing the airflow rate or shutting off the airflow." .

ex:Effective_Air_Temperature_Setpoint a owl:Class ;
    rdfs:label "Effective Air Temperature Setpoint" ;
    rdfs:subClassOf ex:Air_Temperature_Setpoint .

ex:Heating_Temperature_Setpoint a owl:Class ;
    rdfs:label "Heating Temperature Setpoint" ;
    rdfs:subClassOf ex:Temperature_Setpoint ;
    owl:definition "Sets temperature for heating" .

ex:Occupied_Air_Temperature_Setpoint a owl:Class ;
    rdfs:label "Occupied Air Temperature Setpoint" ;
    rdfs:subClassOf ex:Air_Temperature_Setpoint .

ex:Static_Pressure_Setpoint a owl:Class ;
    rdfs:label "Static Pressure Setpoint" ;
    rdfs:comment "Sets static pressure" ;
    rdfs:subClassOf ex:Pressure_Setpoint .

ex:System a owl:Class ;
    rdfs:label "System" ;
    rdfs:subClassOf ex:Collection ;
    owl:comment "A System is a combination of equipment and auxiliary devices (e.g., controls, accessories, interconnecting means, and termi­nal elements) by which energy is transformed so it performs a specific function such as HVAC, service water heating, or lighting. (ASHRAE Dictionary)." .

ex:Unoccupied_Air_Temperature_Setpoint a owl:Class ;
    rdfs:label "Unoccupied Air Temperature Setpoint" ;
    rdfs:subClassOf ex:Air_Temperature_Setpoint ;
    skos:definition "Sets temperature of air when unoccupied" .

ex:Water_Flow_Sensor a owl:Class ;
    rdfs:label "Water Flow Sensor" ;
    rdfs:subClassOf ex:Flow_Sensor ;
    owl:definition "Measures the rate of flow of water" .

ex:Air_Handling_Unit a owl:Class ;
    rdfs:label "Air Handling Unit" ;
    rdfs:subClassOf ex:HVAC_Equipment .

ex:Air_Temperature_Sensor a owl:Class ;
    rdfs:label "Air Temperature Sensor" ;
    rdfs:subClassOf ex:Temperature_Sensor ;
    owl:definition "Measures the temperature of air" .

ex:Electrical_Equipment a owl:Class ;
    rdfs:label "Electrical Equipment" ;
    rdfs:subClassOf ex:Equipment .

ex:Enable_Command a owl:Class ;
    rdfs:label "Enable Command" ;
    rdfs:subClassOf ex:Command .

ex:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:subClassOf ex:Class,
        ex:Entity,
        ex:Space .

ex:Max_Limit a owl:Class ;
    rdfs:label "Max Limit" ;
    rdfs:subClassOf ex:Limit ;
    skos:definition "A parameter that places an upper bound on the range of permitted values of a Setpoint." .

ex:Min_Limit a owl:Class ;
    rdfs:label "Min Limit" ;
    rdfs:subClassOf ex:Limit ;
    owl:definition "A parameter that places a lower bound on the range of permitted values of a Setpoint." .

ex:Supply_Air_Flow_Setpoint a owl:Class ;
    rdfs:label "Supply Air Flow Setpoint" ;
    rdfs:comment "Sets supply air flow rate" ;
    rdfs:subClassOf ex:Air_Flow_Setpoint .

ex:Supply_Air_Temperature_Setpoint a owl:Class ;
    rdfs:label "Supply Air Temperature Setpoint" ;
    rdfs:subClassOf ex:Air_Temperature_Setpoint ;
    owl:comment "Temperature setpoint for supply air" .

ex:Humidity_Setpoint a owl:Class ;
    rdfs:label "Humidity Setpoint" ;
    rdfs:subClassOf ex:Setpoint ;
    owl:definition "Sets humidity" .

ex:Terminal_Unit a owl:Class ;
    rdfs:label "Terminal Unit" ;
    rdfs:subClassOf ex:HVAC_Equipment ;
    owl:definition "A device that regulates the volumetric flow rate and/or the temperature of the controlled medium" .

ex:Limit a owl:Class ;
    rdfs:label "Limit" ;
    rdfs:subClassOf ex:Parameter ;
    skos:definition "A parameter that places an upper or lower bound on the range of permitted values of another point" .

ex:Fan a owl:Class ;
    rdfs:label "Fan" ;
    rdfs:subClassOf ex:HVAC_Equipment ;
    owl:definition "Any device with two or more blades or vanes attached to a rotating shaft used to produce an airflow for the purpose of comfort, ventilation, exhaust, heating, cooling, or any other gaseous transport." .

ex:Space a owl:Class ;
    rdfs:label "Space" ;
    rdfs:subClassOf ex:Location,
        rdfs:Resource ;
    owl:definition "A contiguous part of the physical world that contains or can contain sub-spaces. E.g., a Region can contain many Sites, which in turn can contain many Buildings." ;
    skos:definition "A part of the physical world or a virtual world whose 3D spatial extent is bounded actually or theoretically, and provides for certain functions within the zone it is contained in." .

ex:Collection a owl:Class ;
    rdfs:label "Collection" ;
    rdfs:comment "An administrative grouping of entities that are adressed and treated as a unit for some purpose. These entities may have some spatial arrangement (e.g., an apartment is typically contiguous) but that is not a requirement (see, e.g., a distributed campus consisting of spatially disjoint plots or buildings). Inclusion in a Collection is determined by the 'includes' field on a specific subclass." ;
    rdfs:subClassOf ex:Class,
        ex:Collection,
        ex:Entity,
        rdfs:Resource .

ex:Water_Temperature_Sensor a owl:Class ;
    rdfs:label "Water Temperature Sensor" ;
    rdfs:subClassOf ex:Temperature_Sensor ;
    owl:definition "Measures the temperature of water" .

ex:Valve a owl:Class ;
    rdfs:label "Valve" ;
    rdfs:subClassOf ex:Equipment ;
    owl:definition "A device that regulates, directs or controls the flow of a fluid by opening, closing or partially obstructing various passageways" .

ex:Temperature_Parameter a owl:Class ;
    rdfs:label "Temperature Parameter" ;
    rdfs:subClassOf ex:Parameter ;
    owl:comment "Parameters relevant to temperature-related systems and points" .

ex:Air_Temperature_Setpoint a owl:Class ;
    rdfs:label "Air Temperature Setpoint" ;
    rdfs:subClassOf ex:Temperature_Setpoint ;
    owl:definition "Sets temperature of air" .

ex:Furniture a owl:Class ;
    rdfs:label "Furniture" ;
    rdfs:subClassOf ex:Asset,
        ex:Equipment ;
    owl:definition "Movable objects intended to support various human activities such as seating, eating and sleeping" .

ex:Setpoint a owl:Class ;
    rdfs:label "Setpoint" ;
    rdfs:subClassOf ex:Point ;
    skos:definition "A Setpoint is an input value at which the desired property is set" .

ex:Alarm a owl:Class ;
    rdfs:label "Alarm" ;
    rdfs:subClassOf ex:Point ;
    owl:definition "Alarm points are signals (either audible or visual) that alert an operator to an off-normal condition which requires some form of corrective action" .

ex:Equipment a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:subClassOf ex:Asset,
        ex:Class,
        ex:Entity ;
    owl:definition "devices that serve all or part of the building and may include electric power, lighting, transportation, or service water heating, including, but not limited to, furnaces, boilers, air conditioners, heat pumps, chillers, water heaters, lamps, luminaires, ballasts, elevators, escalators, or other devices or installations." .

ex:Command a owl:Class ;
    rdfs:label "Command" ;
    rdfs:subClassOf ex:Point .

ex:HVAC_Equipment a owl:Class ;
    rdfs:label "HVAC Equipment" ;
    rdfs:subClassOf ex:Equipment ;
    owl:definition "See Heating_Ventilation_Air_Conditioning_System" .

ex:Status a owl:Class ;
    rdfs:label "Status" ;
    rdfs:comment "A Status is input point that reports the current operating mode, state, position, or condition of an item. Statuses are observations and should be considered 'read-only'" ;
    rdfs:subClassOf ex:Point .

ex:Sensor a owl:Class ;
    rdfs:label "Sensor" ;
    rdfs:subClassOf ex:Point ;
    skos:definition "A Sensor is an input point that represents the value of a device or instrument designed to detect and measure a variable (ASHRAE Dictionary)." .

ex:Room a owl:Class ;
    rdfs:label "Room" ;
    rdfs:subClassOf ex:Architecture,
        ex:Space ;
    skos:definition "Base class for all more specific room types." .

ex:ValueShape a owl:Class ;
    rdfs:label "ValueShape" .

