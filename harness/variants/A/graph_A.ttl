ex:Underfloor_Air_Plenum a owl:Class ;
    rdfs:label "Underfloor Air Plenum" ;
    rdfs:subClassOf ex:Supply_Air_Plenum ;
    owl:definition "An open space between a structural concrete slab and the underside of a raised access floor system that connects to an air handling unit to receive conditioned and/or ventilating air before delivery to the room(s)" .

ex:Underfloor_Air_Plenum_Static_Pressure_Sensor a owl:Class ;
    rdfs:label "Underfloor Air Plenum Static Pressure Sensor" ;
    rdfs:subClassOf ex:Air_Static_Pressure_Sensor ;
    owl:definition "Measures the outward push of air against the plenum surfaces and used to measure the resistance when air moves through the plenum" .

ex:Underfloor_Air_Plenum_Static_Pressure_Setpoint a owl:Class ;
    rdfs:label "Underfloor Air Plenum Static Pressure Setpoint" ;
    rdfs:subClassOf ex:Static_Pressure_Setpoint ;
    owl:definition "Sets the underfloor air plenum static pressure" .

ex:Underfloor_Air_Temperature_Sensor a owl:Class ;
    rdfs:label "Underfloor Air Temperature Sensor" ;
    rdfs:subClassOf ex:Air_Temperature_Sensor ;
    skos:definition "Measures the temperature of underfloor air" .

ex:Unit_Failure_Alarm a owl:Class ;
