ex:Automated_External_Defibrillator a owl:Class ;
    rdfs:label "Automated External Defibrillator" ;
    rdfs:subClassOf ex:Safety_Equipment .

ex:Automatic_Mode_Command a owl:Class ;
    rdfs:label "Automatic Mode Command" ;
    rdfs:subClassOf ex:Mode_Command ;
    owl:definition "Controls whether or not a device or controller is operating in \"Automatic\" mode" .

ex:Automatic_Tint_Window a owl:Class ;
    rdfs:label "Automatic Tint Window" ;
    rdfs:subClassOf ex:Shading_Equipment ;
    owl:definition "A window with tint control" .

ex:Automatic_Tint_Window_Array a owl:Class ;
    rdfs:label "Automatic Tint Window Array" ;
    rdfs:subClassOf ex:System ;
    owl:definition "An array of Automatic Tint Windows" .

ex:Automatic_Transfer_Switch a owl:Class ;
    rdfs:label "Automatic Transfer Switch" ;
    rdfs:subClassOf ex:Automatic_Switch,
        ex:Transfer_Switch ;
    owl:definition "An automatic transfer switch (ATS) is a device that automatically transfers a power supply from its primary source to a backup source when it senses a failure or outage in the primary source" .

ex:Availability_Status a owl:Class ;
    rdfs:label "Availability Status" ;
    rdfs:subClassOf ex:Status ;
    owl:definition "Indicates if a piece of equipment, system, or functionality is available for operation" .

ex:Average_Cooling_Demand_Sensor a owl:Class ;
    rdfs:label "Average Cooling Demand Sensor" ;
    rdfs:subClassOf ex:Cooling_Demand_Sensor ;
    owl:definition "Measures the average power consumed by a cooling process as the amount of power consumed over some interval" .

ex:Average_Discharge_Air_Flow_Sensor a owl:Class ;
    rdfs:label "Average Discharge Air Flow Sensor" ;
    rdfs:subClassOf ex:Supply_Air_Flow_Sensor ;
    owl:definition "The computed average flow of discharge air over some interval" .

ex:Average_Exhaust_Air_Static_Pressure_Sensor a owl:Class ;
    rdfs:label "Average Exhaust Air Static Pressure Sensor" ;
    rdfs:subClassOf ex:Exhaust_Air_Static_Pressure_Sensor ;
    owl:definition "The computed average static pressure of air in exhaust regions of an HVAC system over some period of time" .

ex:Average_Heating_Demand_Sensor a owl:Class ;
    rdfs:label "Average Heating Demand Sensor" ;
    rdfs:subClassOf ex:Heating_Demand_Sensor ;
    owl:definition "Measures the average power consumed by a heating process as the amount of power consumed over some interval" .

ex:Average_Supply_Air_Flow_Sensor a owl:Class ;
    rdfs:label "Average Supply Air Flow Sensor" ;
    rdfs:subClassOf ex:Supply_Air_Flow_Sensor ;
    owl:definition "The computed average flow of supply air over some interval" .

ex:Average_Zone_Air_Temperature_Sensor a owl:Class ;
    rdfs:label "Average Zone Air Temperature Sensor" ;
    rdfs:subClassOf ex:Zone_Air_Temperature_Sensor ;
    owl:definition "The computed average temperature of air in a zone, over some period of time" .

ex:AzimuthShape a owl:Class ;
    rdfs:label "AzimuthShape" ;
    rdfs:subClassOf ex:ValueShape .

ex:BACnetController a owl:Class ;
    rdfs:label "BACnet Controller" ;
    rdfs:comment "BACnet controller." ;
    rdfs:subClassOf ex:Controller .

ex:BACnetReference a owl:Class ;
    rdfs:label "BACnet Reference" ;
    rdfs:subClassOf ex:ExternalReference ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ex:ExternalReference [ a owl:Restriction ;
                        owl:hasValue "A reference to the BACnet object represented by this entity."^^xsd:string ;
                        owl:onProperty ex:hasDefinition ] ) ] .

ex:BACnetURI a owl:DatatypeProperty ;
    rdfs:label "BACnetURI" .

ex:BACnet_Controller a owl:Class ;
    rdfs:label "BACnet Controller" ;
    rdfs:subClassOf ex:Controller .

