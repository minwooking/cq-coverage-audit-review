    rdfs:label "Alarm object" ;
    rdfs:subClassOf ex:ServiceObject .

ex:Alarm_Delay_Parameter a owl:Class ;
    rdfs:label "Alarm Delay Parameter" ;
    rdfs:subClassOf ex:Delay_Parameter ;
