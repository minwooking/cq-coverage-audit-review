ex:Centrifugal_Chiller a owl:Class ;
    rdfs:label "Centrifugal Chiller" ;
    rdfs:subClassOf ex:Chiller ;
    owl:definition "A chiller that uses the vapor compression cycle to chill water. It throws off the heat collected from the chilled water plus the heat from the compressor to a water loop" .

ex:Change_Filter_Alarm a owl:Class ;
    rdfs:label "Change Filter Alarm" ;
