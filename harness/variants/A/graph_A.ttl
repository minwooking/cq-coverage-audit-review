    rdfs:subClassOf ex:Electrical_Room ;
    owl:definition "An electrical room where electricity enters and is transformed to different voltages and currents by the equipment contained in the room" .

ex:TreatmentWaitingRoom a owl:Class ;
    rdfs:label "Treatment waiting room" ;
    rdfs:subClassOf ex:TreatmentRoom .

ex:Tunnel a owl:Class ;
    rdfs:label "Tunnel" ;
    rdfs:subClassOf ex:Space ;
