ex:Campus a owl:Class ;
    rdfs:label "Campus" ;
    rdfs:comment "A campus represents a collection of location entities. The constituent locations may have differing legal ownership and utilization purposes, but they are generally perceived as a coherent unit or sub-region within a city or other region. E.g., a university campus, a hospital campus, a corporate campus, etc." ;
    rdfs:subClassOf ex:Collection .

ex:CapacitanceObservation a owl:Class ;
    rdfs:label "Capacitance observation" ;
    rdfs:subClassOf ex:ObservationEvent .

ex:Capacity_Sensor a owl:Class ;
    rdfs:label "Capacity Sensor" ;
    rdfs:subClassOf ex:Sensor .

ex:Capillary_Tube_Metering_Device a owl:Class ;
    rdfs:label "Capillary Tube Metering Device" ;
    rdfs:subClassOf ex:Refrigerant_Metering_Device ;
