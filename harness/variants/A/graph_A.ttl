ex:Alternating_Current_FrequencyQuantityShape a owl:Class ;
    rdfs:label "Alternating Current FrequencyQuantityShape" ;
    rdfs:subClassOf ex:ValueShape .

ex:Ammonia_ConcentrationQuantityShape a owl:Class ;
    rdfs:label "Ammonia ConcentrationQuantityShape" ;
    rdfs:subClassOf ex:ValueShape .

ex:Ammonia_Sensor a owl:Class ;
    rdfs:label "Ammonia Sensor" ;
    rdfs:subClassOf ex:Air_Quality_Sensor .

ex:AngleObservation a owl:Class ;
    rdfs:label "Angle observation" ;
