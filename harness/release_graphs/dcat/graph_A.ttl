ex:isPartOf a owl:ObjectProperty ;
    rdfs:label "Is Part Of",
        "is part of" ;
    rdfs:comment "A dataset series of which the dataset is part." ;
    rdfs:domain ex:ChildDataset,
        dcat:Dataset ;
    rdfs:range ex:DatasetSeries,
        dcat:DatasetSeries ;
    rdfs:subPropertyOf dcterms:isPartOf ;
    owl:equivalentProperty dcterms:isPartOf .

ex:isPartOfSeries a owl:ObjectProperty ;
    rdfs:label "is part of series" ;
    rdfs:comment "A dataset may be part of a dataset series." ;
    rdfs:domain ex:Dataset ;
    rdfs:range ex:DatasetSeries .

ex:isPublisherOf a owl:ObjectProperty ;
    rdfs:label "is publisher of" ;
    rdfs:comment "The publisher of the catalog has the relative IRI ex:transparency-office." ;
    rdfs:domain ex:transparency-office ;
    rdfs:range ex:Catalog .

ex:isReferencedBy a owl:ObjectProperty ;
    rdfs:label "isReferencedBy" ;
    rdfs:comment "A related resource, such as a publication, that references, cites, or otherwise points to the cataloged resource.",
        "A resource that references the described resource.",
        "Used to associate a resource with the resource that references it, e.g., a dataset referenced by a publication." ;
    rdfs:domain ex:Resource ;
    rdfs:subPropertyOf dcterms:isReferencedBy .

ex:isReplacedBy a owl:ObjectProperty ;
    rdfs:label "is replaced by",
        "isReplacedBy" ;
    rdfs:comment "A resource that replaces the described resource." ;
    rdfs:domain ex:Resource ;
    rdfs:equivalentProperty dcterms:isReplacedBy ;
    rdfs:range ex:Resource ;
    rdfs:subPropertyOf dcterms:isReplacedBy .

ex:isRequiredBy a owl:ObjectProperty ;
    rdfs:label "isRequiredBy" ;
    rdfs:comment "A resource that requires the described resource." ;
    rdfs:subPropertyOf dcterms:isRequiredBy .

ex:isVersionOf a owl:ObjectProperty ;
    rdfs:label "is version of",
        "isVersionOf" ;
    rdfs:comment "A resource that the described resource is a version of." ;
    rdfs:domain ex:Resource,
        ex:ResourceVersion ;
    rdfs:inverseOf ex:hasVersion ;
    rdfs:range ex:Resource ;
    rdfs:subPropertyOf dcterms:isVersionOf ;
    owl:inverseOf ex:hasVersion .

ex:issued a owl:DatatypeProperty ;
    rdfs:label "issued" ;
    ns1:label "issued" ;
    rdfs:domain ex:Resource,
        dcat:Resource ;
    rdfs:equivalentProperty dcterms:issued ;
    rdfs:range xsd:anySimpleType,
        xsd:date,
        xsd:string .

ex:keyword a owl:DatatypeProperty ;
    rdfs:label "keyword" ;
    rdfs:comment "A keyword or tag describing the resource.",
        "In DCAT 2, the domain of dcat:keyword was relaxed from dcat:Dataset to ex:Resource." ;
    rdfs:domain ex:Resource ;
    rdfs:range xsd:string .

ex:landingPage a owl:ObjectProperty ;
    rdfs:label "landingPage" ;
    rdfs:comment "A Web page that can be navigated to in a Web browser to gain access to the catalog, a dataset, its distributions and/or additional information.",
        "In DCAT 2, the domain of dcat:landingPage was relaxed from dcat:Dataset to ex:Resource." ;
