ex:AlejandraGonzalezBeltran a owl:NamedIndividual ;
    rdfs:label "Alejandra Gonzalez Beltran" ;
    ex:affiliation ex:ScienceAndTechnologyFacilitiesCouncil ;
    ex:previousAffiliation ex:UniversityOfOxford ;
    ex:role "Invited Expert" .

ex:StatusTransition a owl:Class ;
    rdfs:label "Status transition" .

ex:Agent a owl:Class ;
    rdfs:label "Agent" ;
    ns1:label "Agent" ;
    rdfs:comment "An entity responsible for publishing or curating data.",
        "An entity with responsibility for a resource.",
        "Provides several properties to describe these entities." ;
    rdfs:subClassOf foaf:Agent .

ex:CatalogRecord a owl:Class ;
    rdfs:label "Catalog Record",
        "Catalog record",
        "CatalogRecord",
        "catalog record" ;
    ns1:label "CatalogRecord" ;
    rdfs:comment "A metadata record in the catalog, primarily concerning the registration information, such as who added the record and when.",
        "A record in a catalog, describing the registration of a single dcat:Resource." ;
    rdfs:subClassOf ex:Resource,
        dcat:CatalogRecord .

ex:ResourceVersion a owl:Class ;
    rdfs:label "Resource Version" .

ex:Versioning a owl:Class ;
    rdfs:label "Versioning" .

ex:DCATProfile a owl:Class ;
    rdfs:label "DCAT profile" .

ex:DCAT a owl:Class ;
    rdfs:label "DCAT" ;
    ex:hasExtension ex:DCATAP,
        ex:DataTagSuite,
        ex:HealthcareAndLifeSciencesProfile ;
    ex:hasNamespace ex:DCATNamespace ;
    ex:isBasedOn ex:Resource .

ex:DataService a owl:Class ;
    rdfs:label "Data Service",
        "DataService" ;
    ex:hasParentClass ex:Resource ;
    ns1:label "DataService" ;
    rdfs:comment "A collection of operations accessible through an interface (API) that provide access to one or more datasets or data processing functions." ;
    rdfs:subClassOf ex:Resource,
        dcat:DataService .

ex:LifeCycle a owl:Class ;
    rdfs:label "Life-cycle" .

ex:Catalog a owl:Class ;
    rdfs:label "Catalog" ;
    ex:hasParentClass ex:Resource ;
    ns1:label "Catalog" ;
    rdfs:comment "A kind of dataset whose member items are descriptions of datasets and data services." ;
    rdfs:subClassOf ex:Dataset,
        ex:Resource,
        dcat:Catalog,
        dcat:Dataset .

ex:DCAT2 a ex:DCAT2,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "DCAT 2" .

ex:ChildDataset a owl:Class ;
    rdfs:label "Child Dataset" ;
    owl:equivalentClass dcat:Distribution .

ex:Distribution a owl:Class ;
    rdfs:label "Distribution" ;
    rdfs:comment "A representation of a dataset.",
        "An accessible form of a dataset such as a downloadable file." ;
    rdfs:subClassOf ex:Resource,
        dcat:Distribution .

ex:DCAT3 a ex:DCAT3,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "DCAT 3" ;
    ex:addsNewClasses ex:DatasetSeries,
        ex:InverseProperties,
        ex:Versioning ;
    ex:addsNewProperties ex:DatasetSeries,
        ex:InverseProperties,
        ex:Versioning ;
    ex:doesNotObsoletes ex:DCAT2 ;
    ex:hasContributor ex:MakxDekkers ;
    ex:hasEditor ex:AlejandraGonzalezBeltran,
        ex:AndreaPerego,
        ex:DavidBrowning,
        ex:PeterWinstanley,
        ex:RiccardoAlbertoni,
        ex:SimonJDCox ;
    ex:hasErrata true ;
    ex:hasFeedbackMechanism ex:GitHub,
        ex:publicDXWGComments ;
    ex:hasFormerEditor ex:FadiMaali,
        ex:JohnErickson ;
    ex:hasHistory "https://www.w3.org/standards/history/vocab-dcat-3/"^^xsd:string ;
    ex:hasImplementationReport "https://w3c.github.io/dxwg/dcat3-implementation-report/"^^xsd:string ;
    ex:hasLatestEditorsDraft "https://w3c.github.io/dxwg/dcat/"^^xsd:string ;
    ex:hasLatestVersion "https://www.w3.org/TR/vocab-dcat-3/"^^xsd:string ;
    ex:hasNonNormativeFormat ex:JSONLD,
        ex:RDFXML,
        ex:Turtle ;
    ex:hasPreviousRecommendation "https://www.w3.org/TR/2020/REC-vocab-dcat-2-20200204/"^^xsd:string ;
    ex:maintainsBackwardCompatibility ex:DCAT2 ;
    ex:relaxesConstraints ex:DCAT2 ;
    ex:supersedes ex:DCAT2 .

ex:LifeCycleStatus a owl:Class ;
    rdfs:label "Life-cycle status" .

ex:Dataset a owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Dataset" ;
    ex:hasParentClass ex:Resource ;
    ns1:label "Dataset" ;
    ex:usesComplementaryVocabulary ex:VoID ;
    rdfs:comment "A collection of data that this data service can distribute.",
        "A collection of data, published or curated by a single agent, and available for access or download in one or more serializations or formats.",
        "A resource described in DCAT." ;
    rdfs:subClassOf ex:Resource,
        dcat:Dataset,
        dcat:Resource .

ex:DatasetSeries a owl:Class ;
    rdfs:label "Dataset Series",
        "Dataset series",
        "DatasetSeries" ;
    rdfs:comment "A dataset that represents a collection of datasets that are published separately, but share some characteristics that group them." ;
    rdfs:subClassOf ex:Dataset,
        dcat:Dataset ;
    owl:equivalentClass dcat:Dataset .

ex:Resource a owl:Class ;
    rdfs:label "Resource" ;
    ex:hasSubClass ex:Catalog,
        ex:DataService,
        ex:Dataset ;
    ns1:label "Resource" ;
    rdfs:comment "A general class for resources cataloged in DCAT; datasets and data services are sub-classes.",
        "A general resource described in DCAT." ;
    rdfs:subClassOf dcat:Resource .

