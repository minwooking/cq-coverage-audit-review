@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/chunktograph#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ns1: <http://example.org/chunktograph#rdfs:> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ADMSStatusCompleted a ex:ADMSStatusVocabulary ;
    rdfs:label "completed" .

ex:ADMSStatusDeprecated a ex:ADMSStatusVocabulary ;
    rdfs:label "deprecated" .

ex:ADMSStatusUnderDevelopment a ex:ADMSStatusVocabulary ;
    rdfs:label "under development" .

ex:ADMSStatusWithdrawn a ex:ADMSStatusVocabulary ;
    rdfs:label "withdrawn" .

ex:CI_RoleCode a owl:Class ;
    rdfs:label "CI Role Code" .

ex:Centroid a owl:Class ;
    rdfs:label "Centroid" ;
    rdfs:comment "The geographic center (centroid) of a spatial thing." .

ex:Checksum a owl:Class ;
    rdfs:label "Checksum" ;
    rdfs:comment "A Checksum is a value that allows to check the integrity of the contents of a file. Even small changes to the content of the file will change its checksum. This class allows the results of a variety of checksum and cryptographic message digest algorithms to be represented." .

ex:ChecksumAlgorithm a owl:Class ;
    rdfs:label "Checksum Algorithm" ;
    rdfs:comment "The set of individuals of class spdx:ChecksumAlgorithm. Version 2.2 defines individuals for the following algorithms: MD2, MD4, MD5, MD6, SHA-1, SHA-224, SHA-256, SHA-384, SHA-512." .

ex:Collection a owl:Class ;
    rdfs:label "Collection" ;
    rdfs:comment "A group of concepts." .

ex:ConceptScheme a owl:Class ;
    rdfs:label "ConceptScheme" ;
    rdfs:comment "A collection of concepts organized in a structured way." .

ex:CreativeCommons a owl:NamedIndividual ;
    rdfs:label "Creative Commons" ;
    rdfs:comment "Canonical IRIs of well-known licenses such as those defined by Creative Commons are recommended for interoperability." .

ex:CrossRef a owl:NamedIndividual ;
    rdfs:label "CrossRef" ;
    rdfs:comment "CrossRef and DataCite display guidelines recommend displaying DOIs as full URL link in the form https://doi.org/10.xxxx/xxxxx/." .

ex:DCAT-AP a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "DCAT-AP" .

ex:DCAT-AP-NO a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "DCAT-AP-NO" .

ex:DCAT-AP-SE a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "DCAT-AP-SE" .

ex:DCAT-AP.de a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "DCAT-AP.de" .

ex:DCAT-AP_IT a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "DCAT-AP_IT" .

ex:DCAT-BE a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "DCAT-BE" .

ex:DCMITypeVocabulary a owl:Class ;
    rdfs:label "DCMI Type Vocabulary" ;
    rdfs:comment "A controlled vocabulary for resource types." .

ex:DOI a owl:NamedIndividual ;
    rdfs:label "DOI" ;
    rdfs:comment "DOI is registered as a namespace in the info IRI scheme." .

ex:DS_AssociationTypeCode a owl:Class ;
    rdfs:label "DS Association Type Code" .

ex:DataCite a owl:NamedIndividual ;
    rdfs:label "DataCite" ;
    rdfs:comment "DataCite display guidelines recommend displaying DOIs as full URL link in the form https://doi.org/10.xxxx/xxxxx/." .

ex:DataciteResourceTypes a owl:Class ;
    rdfs:label "Datacite Resource Types" ;
    rdfs:comment "A controlled vocabulary for resource types from Datacite." .

ex:Description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:comment "A free-text account of the record." ;
    rdfs:domain ex:CatalogRecord ;
    rdfs:range rdfs:Literal .

ex:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A Web page or document accessible via a URI." .

ex:ELI a owl:NamedIndividual ;
    rdfs:label "ELI" ;
    rdfs:comment "ELI is an identifier for creative works." .

ex:EndDate a owl:DatatypeProperty ;
    rdfs:label "End Date" ;
    rdfs:comment "The end of the period. Encoded using ISO 8601 Date and Time compliant string typed with xsd:gYear, xsd:gYearMonth, xsd:date, or xsd:dateTime." ;
    rdfs:domain dcterms:PeriodOfTime ;
    rdfs:range xsd:string .

ex:EndpointDescription a owl:Class ;
    rdfs:label "Endpoint Description" ;
    rdfs:comment "The endpoint description gives specific details of the actual endpoint instances, while dcterms:conformsTo is used to indicate the general standard or specification that the endpoints implement." .

ex:First a owl:ObjectProperty ;
    rdfs:label "first" ;
    rdfs:comment "The first resource in an ordered collection or series of resources, to which the current resource belongs." ;
    rdfs:subPropertyOf <http://www.w3.org/1999/xhtml/vocab#first> .

ex:Frequency a owl:Class ;
    rdfs:label "Frequency" ;
    rdfs:subClassOf dcterms:Frequency .

ex:GeoDCAT-AP a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "GeoDCAT-AP" .

ex:GeoDCAT-AP_IT a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "GeoDCAT-AP_IT" .

ex:HasCurrentVersion a owl:ObjectProperty ;
    rdfs:label "has current version" ;
    rdfs:comment "This resource has a more specific, versioned resource with equivalent content." ;
    rdfs:subPropertyOf <http://purl.org/pav/hasVersion> ;
    owl:equivalentProperty <http://purl.org/pav/hasCurrentVersion> .

ex:HasVersion a owl:ObjectProperty ;
    rdfs:label "has version" ;
    rdfs:comment "This resource has a more specific, versioned resource." ;
    rdfs:subPropertyOf dcterms:hasVersion,
        prov:generalizationOf ;
    owl:equivalentProperty <http://purl.org/pav/hasVersion> .

ex:HydraAPIDescription a owl:Class ;
    rdfs:label "Hydra API Description" ;
    rdfs:comment "A machine-readable form of an endpoint description." .

ex:ISNI a owl:NamedIndividual ;
    rdfs:label "ISNI" ;
    rdfs:comment "ISNI is an identifier for actors such as authors and publishers." .

ex:Last a owl:ObjectProperty ;
    rdfs:label "last" ;
    rdfs:comment "The last resource in an ordered collection or series of resources, to which the current resource belongs." ;
    rdfs:subPropertyOf <http://www.w3.org/1999/xhtml/vocab#last> .

ex:LicenseDocument a owl:Class ;
    rdfs:label "LicenseDocument" ;
    rdfs:comment "A legal document under which the resource is made available." .

ex:LinguisticSystem ns1:label "LinguisticSystem" ;
    rdfs:subClassOf dcterms:LinguisticSystem .

ex:ListingDate a owl:DatatypeProperty ;
    rdfs:label "listing date" ;
    rdfs:comment "The date of listing (i.e., formal recording) of the corresponding dataset or service in the catalog." ;
    rdfs:domain ex:CatalogRecord ;
    rdfs:range xsd:date,
        xsd:dateTime,
        xsd:gYear,
        xsd:gYearMonth .

ex:MARCIntellectualResourceTypes a owl:Class ;
    rdfs:label "MARC Intellectual Resource Types" ;
    rdfs:comment "A controlled vocabulary for intellectual resource types from MARC." .

ex:MD2 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "MD2" ;
    rdfs:comment "MD2 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:MD4 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "MD4" ;
    rdfs:comment "MD4 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:MD5 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "MD5" ;
    rdfs:comment "MD5 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:MD6 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "MD6" ;
    rdfs:comment "MD6 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:Name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:comment "A name given to the record." ;
    rdfs:domain ex:CatalogRecord ;
    rdfs:range rdfs:Literal .

ex:ODRS a owl:NamedIndividual ;
    rdfs:label "Open Data Rights Statement Vocabulary" ;
    rdfs:comment "A more sophisticated approach to express rights, based on and extending, is provided by the Open Data Rights Statement Vocabulary (ODRS), which defines properties for specifying, among others, copyright statements and copyright notices." .

ex:OGCGetCapabilities a owl:Class ;
    rdfs:label "OGC GetCapabilities Response" ;
    rdfs:comment "A machine-readable form of an endpoint description." .

ex:ORCID a owl:NamedIndividual ;
    rdfs:label "ORCID" ;
    rdfs:comment "ORCID is an identifier for actors such as authors and publishers." .

ex:Ontology a owl:Class ;
    rdfs:label "Ontology" ;
    rdfs:comment "A formal representation of knowledge." .

ex:OpenAPIDescription a owl:Class ;
    rdfs:label "OpenAPI (Swagger) Description" ;
    rdfs:comment "A machine-readable form of an endpoint description." .

ex:Organization ns1:label "Organization" ;
    rdfs:subClassOf ex:Agent .

ex:PARSEInsightContentTypes a owl:Class ;
    rdfs:label "PARSE.Insight Content-Types" ;
    rdfs:comment "A controlled vocabulary for content types used by re3data.org." .

ex:Person ns1:label "Person" ;
    rdfs:subClassOf ex:Agent .

ex:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "An ODRL conformant policy expressing rights." .

ex:Previous a owl:ObjectProperty ;
    rdfs:label "previous" ;
    rdfs:comment "The previous resource (before the current one) in an ordered collection or series of resources." ;
    rdfs:subPropertyOf <http://www.w3.org/1999/xhtml/vocab#prev> .

ex:PreviousVersion a owl:ObjectProperty ;
    rdfs:label "previous version" ;
    rdfs:comment "The previous version of a resource in a lineage." ;
    rdfs:subPropertyOf prov:wasRevisionOf ;
    owl:equivalentProperty <http://purl.org/pav/previousVersion> .

ex:RelationshipTarget a owl:Class ;
    rdfs:label "Relationship Target" ;
    rdfs:comment "The resource related to the source resource." .

ex:Replaces a owl:ObjectProperty ;
    rdfs:label "replaces" ;
    rdfs:comment "A related resource that is supplanted, displaced, or superseded by the described resource." ;
    rdfs:subPropertyOf dcterms:relation .

ex:RightsStatement a owl:Class ;
    rdfs:label "RightsStatement" ;
    ns1:label "RightsStatement" ;
    rdfs:comment "A statement concerning rights not addressed by license or access rights." ;
    rdfs:subClassOf dcterms:RightsStatement .

ex:SHA1 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "SHA-1" ;
    rdfs:comment "SHA-1 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:SHA224 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "SHA-224" ;
    rdfs:comment "SHA-224 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:SHA256 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "SHA-256" ;
    rdfs:comment "SHA-256 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:SHA384 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "SHA-384" ;
    rdfs:comment "SHA-384 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:SHA512 a <http://spdx.org/rdf/terms#ChecksumAlgorithm>,
        owl:NamedIndividual ;
    rdfs:label "SHA-512" ;
    rdfs:comment "SHA-512 is a checksum algorithm defined in version 2.2 of SPDX." .

ex:SPARQLServiceDescription a owl:Class ;
    rdfs:label "SPARQL Service Description" ;
    rdfs:comment "A machine-readable form of an endpoint description." .

ex:StartDate a owl:DatatypeProperty ;
    rdfs:label "Start Date" ;
    rdfs:comment "The start of the period. Encoded using ISO 8601 Date and Time compliant string typed with xsd:gYear, xsd:gYearMonth, xsd:date, or xsd:dateTime." ;
    rdfs:domain dcterms:PeriodOfTime ;
    rdfs:range xsd:string .

ex:StatDCAT-AP a ex:DCATProfile,
        owl:NamedIndividual ;
    rdfs:label "StatDCAT-AP" .

ex:Status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:comment "The status of the resource in the context of a particular workflow process." ;
    rdfs:range skos:Concept .

ex:Theme a owl:Class ;
    rdfs:label "Theme" ;
    rdfs:comment "A category or a theme used to describe datasets in the catalog." ;
    rdfs:subClassOf skos:Concept .

ex:ThemeTaxonomy a owl:Class ;
    rdfs:label "Theme Taxonomy" ;
    rdfs:comment "A knowledge organization system (KOS) used to represent themes/categories of datasets in the catalog." ;
    rdfs:subClassOf skos:ConceptScheme .

ex:VIAF a owl:NamedIndividual ;
    rdfs:label "VIAF" ;
    rdfs:comment "VIAF is an identifier for actors such as authors and publishers." .

ex:Version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "The version indicator (name or identifier) of a resource." ;
    rdfs:range rdfs:Literal ;
    owl:equivalentProperty <http://purl.org/pav/version> .

ex:VersionNotes a owl:DatatypeProperty ;
    rdfs:label "version notes" ;
    rdfs:comment "A description of changes between this version and the previous version of the resource." ;
    rdfs:range rdfs:Literal .

ex:WKTLiteral a owl:Datatype ;
    rdfs:label "WKT literal" ;
    rdfs:comment "The geometry could be encoded as a WKT literal (geosparql:wktLiteral)." ;
    rdfs:subClassOf rdfs:Literal .

ex:Zenodo a owl:NamedIndividual ;
    rdfs:label "Zenodo" ;
    rdfs:comment "Example of a registrant for identifiers; however, representing the authority responsible for assigning identifiers goes against the philosophy of DOI." .

ex:accepted a ex:LifeCycleStatus ;
    rdfs:label "accepted" .

ex:accessRights a owl:ObjectProperty ;
    rdfs:label "access rights",
        "accessRights" ;
    rdfs:comment "A statement about access rights to the resource.",
        "use dcterms:accessRights to express statements concerning only access rights." ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal ;
    rdfs:subPropertyOf dcterms:rights .

ex:accessURL a owl:ObjectProperty ;
    rdfs:label "accessURL" ;
    rdfs:comment "A URL for direct access to a distribution." ;
    rdfs:domain ex:Distribution ;
    rdfs:range xsd:anyURI .

ex:accountability a skos:Concept ;
    rdfs:label "Accountability" ;
    skos:inScheme ex:themes .

ex:accrualPeriodicity a owl:DatatypeProperty ;
    rdfs:label "Accrual Periodicity",
        "accrual periodicity" ;
    rdfs:comment "The frequency at which a dataset is published." ;
    rdfs:domain ex:DatasetSeries,
        ex:Resource,
        dcat:Dataset ;
    rdfs:equivalentProperty dcterms:accrualPeriodicity ;
    rdfs:range dcterms:Frequency,
        xsd:string .

ex:addsNewClasses a owl:ObjectProperty ;
    rdfs:label "adds new classes" ;
    rdfs:domain ex:DCAT3 ;
    rdfs:range ex:DCAT2 .

ex:addsNewProperties a owl:ObjectProperty ;
    rdfs:label "adds new properties" ;
    rdfs:domain ex:DCAT3 ;
    rdfs:range ex:DCAT2 .

ex:admsIdentifier a owl:DatatypeProperty ;
    rdfs:label "ADMS identifier" ;
    rdfs:comment "The property adms:identifier can express other locally minted identifiers or external identifiers, like DOI, ELI, arΧiv for creative works and ORCID, VIAF, ISNI for actors such as authors and publishers, as long as the identifiers are globally unique and stable." ;
    rdfs:domain owl:Thing ;
    rdfs:range rdfs:Literal .

ex:alternateOf a owl:ObjectProperty ;
    rdfs:label "alternateOf" ;
    rdfs:comment "A resource that is an alternate of the described resource." ;
    rdfs:subPropertyOf prov:alternateOf .

ex:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:domain ex:measurement_complianceToDWBP ;
    rdfs:range owl:Thing .

ex:arXiv a owl:NamedIndividual ;
    rdfs:label "arXiv" ;
    rdfs:comment "arXiv is an identifier scheme for creative works." .

ex:bbox a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "Bounding Box",
        "bounding box" ;
    rdfs:comment "The geographic bounding box of a spatial thing. Range allows different geometry literal encodings such as WKT." ;
    rdfs:domain ex:Location ;
    rdfs:equivalentProperty dcat:bbox ;
    rdfs:range rdfs:Literal,
        xsd:string .

ex:catalog a owl:ObjectProperty ;
    rdfs:label "catalog" ;
    rdfs:comment "A sub-property of dcat:hasPart for linking to a catalog." ;
    rdfs:subPropertyOf dcat:catalog .

ex:catalogEntryModificationDate a owl:DatatypeProperty ;
    rdfs:label "Catalog Entry Modification Date" ;
    rdfs:comment "Most recent date on which the catalog entry was changed, updated or modified." ;
    rdfs:domain ex:CatalogRecord ;
    rdfs:range xsd:dateTime .

ex:centroid a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:label "Centroid",
        "centroid" ;
    rdfs:comment "The geographic center of a spatial area, or another characteristic point." ;
    rdfs:domain ex:Location ;
    rdfs:equivalentProperty dcat:centroid ;
    rdfs:range rdfs:Literal,
        xsd:string .

ex:checksumAlgorithm a owl:ObjectProperty ;
    rdfs:label "checksum algorithm" ;
    rdfs:comment "Identifies the algorithm used to produce the subject Checksum." ;
    rdfs:domain <http://spdx.org/rdf/terms#Checksum> ;
    rdfs:range <http://spdx.org/rdf/terms#ChecksumAlgorithm> .

ex:checksumValue a owl:DatatypeProperty ;
    rdfs:label "checksum value" ;
    rdfs:comment "The checksumValue property provides a lowercase hexadecimal encoded digest value produced using a specific algorithm." ;
    rdfs:domain <http://spdx.org/rdf/terms#Checksum> ;
    rdfs:range xsd:hexBinary .

ex:completed a ex:LifeCycleStatus ;
    rdfs:label "completed" .

ex:completenessWRTExpectedNumberOfEntities a owl:NamedIndividual ;
    rdfs:label "Completeness with Respect to Expected Number of Entities" .

ex:conformant a owl:NamedIndividual ;
    rdfs:label "conformant" .

ex:conformsTo a owl:ObjectProperty ;
    rdfs:label "Conforms To",
        "conforms to",
        "conformsTo" ;
    ns1:label "conforms to" ;
    rdfs:comment "A standard to which the resource conforms.",
        "An established standard to which the described resource conforms." ;
    rdfs:domain ex:DataService,
        dcat:Resource ;
    rdfs:range ex:Standard,
        dcterms:Standard,
        xsd:anyURI ;
    rdfs:subPropertyOf dcterms:conformsTo .

ex:consumer1 a owl:NamedIndividual ;
    rdfs:label "consumer1" .

ex:contactPoint a owl:ObjectProperty ;
    ns1:label "contact point" ;
    rdfs:domain dcat:Resource ;
    rdfs:range <http://www.w3.org/2006/vcard/ns#Kind> .

ex:created a owl:DatatypeProperty ;
    rdfs:label "created" ;
    rdfs:domain ex:Resource ;
    rdfs:range xsd:string .

ex:creationDate a owl:DatatypeProperty ;
    rdfs:label "creation date" ;
    rdfs:domain ex:DatasetSeries ;
    rdfs:range xsd:date .

ex:creator a owl:ObjectProperty,
        owl:Property ;
    rdfs:label "dataset creator" ;
    ns1:label "creator" ;
    rdfs:domain ex:ChildDataset,
        dcat:Resource ;
    rdfs:range owl:Thing,
        foaf:Agent .

ex:dataset a owl:ObjectProperty ;
    rdfs:label "dataset" ;
    rdfs:comment "A sub-property of dcat:hasPart for linking to a dataset." ;
    rdfs:subPropertyOf dcat:dataset .

ex:dataset-001 a ex:Dataset,
        owl:NamedIndividual ;
    rdfs:label "Dataset 001",
        "dataset-001" ;
    rdfs:comment "An example dataset with relative IRI ex:dataset-001." .

ex:dataset-001-csv a dcat:Distribution ;
    rdfs:label "Dataset 001 CSV Distribution" .

ex:dataset-002 a ex:Dataset ;
    rdfs:label "Dataset 002" .

ex:dataset-003 a ex:Dataset ;
    rdfs:label "Dataset 003" .

ex:dataset-004 a ex:Dataset ;
    rdfs:label "Dataset 004" .

ex:datasetIdentifier a owl:DatatypeProperty ;
    rdfs:label "dataset identifier" ;
    rdfs:domain ex:ChildDataset ;
    rdfs:range xsd:string .

ex:datasetLicenseInfo a owl:DatatypeProperty ;
    rdfs:label "Dataset License Information" ;
    rdfs:comment "Information about licenses and rights provided for a Dataset in addition to but not instead of the information provided for the Distributions of that Dataset." ;
    rdfs:domain dcat:Dataset ;
    rdfs:range xsd:string .

ex:datasetReleaseDate a owl:DatatypeProperty ;
    rdfs:label "Dataset Release Date" ;
    rdfs:comment "The date of listing the dataset in the catalog and not the publication date of the dataset itself." ;
    rdfs:domain dcat:Dataset ;
    rdfs:range xsd:dateTime .

ex:datasetRightsInfo a owl:DatatypeProperty ;
    rdfs:label "Dataset Rights Information" ;
    rdfs:comment "Information about rights provided for a Dataset in addition to but not instead of the information provided for the Distributions of that Dataset." ;
    rdfs:domain dcat:Dataset ;
    rdfs:range xsd:string .

ex:datasetSeriesType a owl:ObjectProperty ;
    rdfs:label "dataset series type" ;
    rdfs:domain ex:DatasetSeries ;
    rdfs:range owl:Thing ;
    owl:equivalentProperty dcterms:type .

ex:dateAccepted a owl:DatatypeProperty ;
    rdfs:label "date accepted" ;
    rdfs:domain ex:Resource ;
    rdfs:range xsd:string .

ex:dateCopyrighted a owl:DatatypeProperty ;
    rdfs:label "date copyrighted" ;
    rdfs:domain ex:Resource ;
    rdfs:range xsd:string .

ex:dateSubmitted a owl:DatatypeProperty ;
    rdfs:label "date submitted" ;
    rdfs:domain ex:Resource ;
    rdfs:range xsd:string .

ex:deprecated a ex:LifeCycleStatus ;
    rdfs:label "deprecated" .

ex:description a owl:DatatypeProperty ;
    ns1:label "description" ;
    rdfs:domain dcat:Resource ;
    rdfs:range rdfs:Literal .

ex:distribution a owl:ObjectProperty ;
    rdfs:label "distribution" ;
    rdfs:comment "Link from a dcat:Dataset to a representation of the dataset, described as a dcat:Distribution." ;
    rdfs:domain ex:Dataset ;
    rdfs:range ex:Distribution ;
    rdfs:subPropertyOf dcat:distribution .

ex:doesNotObsoletes a owl:ObjectProperty ;
    rdfs:label "does not obsoletes" ;
    rdfs:domain ex:DCAT3 ;
    rdfs:range ex:DCAT2 .

ex:experimental a ex:LifeCycleStatus ;
    rdfs:label "experimental" .

ex:format a owl:ObjectProperty ;
    rdfs:label "format" ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource." ;
    rdfs:domain ex:Resource ;
    rdfs:range xsd:string .

ex:genoaBusStopsDataset a ex:ChildDataset ;
    rdfs:label "Genoa Bus Stops Dataset" ;
    ex:datasetIdentifier "genoa-bus-stops" ;
    ex:hasQualityAnnotation ex:genoaBusStopsDatasetCompletenessNote ;
    ex:publisher "Genoa Transport Authority" ;
    ex:releaseDate "2023-01-15"^^xsd:date ;
    ex:title "Georeferenced List of Bus Stops in Genoa" .

ex:geometry a owl:ObjectProperty ;
    rdfs:label "geometry" ;
    rdfs:domain ex:Location ;
    rdfs:equivalentProperty <http://www.w3.org/ns/locn#geometry> ;
    rdfs:range xsd:string .

ex:hadPrimarySource a owl:ObjectProperty ;
    rdfs:label "hadPrimarySource" ;
    rdfs:comment "A resource that is the primary source of the described resource." ;
    rdfs:subPropertyOf prov:hadPrimarySource .

ex:hadRole a owl:ObjectProperty ;
    rdfs:label "had role" ;
    rdfs:domain prov:Attribution ;
    rdfs:range owl:Thing .

ex:hasADMS a owl:DatatypeProperty ;
    rdfs:label "has ADMS" ;
    rdfs:domain ex:DCAT ;
    rdfs:range xsd:string .

ex:hasAccessRights a owl:ObjectProperty ;
    rdfs:label "has access rights" ;
    ns1:label "has access rights" ;
    rdfs:domain ex:Distribution,
        dcat:Resource ;
    rdfs:range dcterms:RightsStatement .

ex:hasAccessURL a owl:ObjectProperty ;
    rdfs:label "has access URL" ;
    rdfs:domain ex:Distribution ;
