ex:BrickConsortiumInc a ex:BrickConsortium,
        ex:NonProfitMembershipCorporation,
        owl:NamedIndividual ;
    rdfs:label "Brick Consortium, Inc",
        "The Brick Consortium, Inc." ;
    ex:addresses "an important industry and societal need by helping to make data of the built environment interoperable"^^xsd:string ;
    ex:develops ex:BrickSchemaSpecification ;
    ex:ensuresNotEncumbered ex:BrickSchemaSpecification ;
    ex:evangelizes ex:BrickSchemaSpecification ;
    ex:funds ex:Research ;
    ex:hasContact "Erik Paulson"^^xsd:string ;
    ex:hasEvent "a virtual open house in 2021"^^xsd:string ;
    ex:hasGoal ex:Comfort,
        ex:Efficiency,
        ex:HealthyBuildings,
        ex:Interoperability,
        ex:OpenSourceCommunity,
        ex:SmartBuildings,
        ex:Sustainability ;
    ex:hasMember ex:CarnegieMellonUniversity,
        ex:Carrier,
        ex:ClockworksAnalytics,
        ex:ColoradoSchoolOfMines,
        ex:JohnsonControls,
        ex:Mapped,
        ex:SchneiderElectric,
        ex:UniversityOfCaliforniaBerkeley,
        ex:UniversityOfCaliforniaSanDiego ;
    ex:hasMembershipForm "a membership form is available"^^xsd:string ;
    ex:hasPurpose "to encourage the research and development of Brick Schema Specifications for the built environment and any supporting tooling, documentation, and best practices necessary to promote Brick"^^xsd:string ;
    ex:hasRule "rules of the consortium are available for review"^^xsd:string ;
    ex:isMadeUpOf "researchers, technology providers, integrators, and building operators"^^xsd:string ;
    ex:provides ex:CanonicalUseCase,
        ex:Governance,
        ex:ReferenceModel,
        ex:Tooling .

