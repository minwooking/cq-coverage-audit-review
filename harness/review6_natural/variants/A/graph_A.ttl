ex:AHU_Average_Exhaust_Air_Static_Pressure_Sensor a ex:Point,
        owl:Class ;
    rdfs:label "AHU Average Exhaust Air Static Pressure Sensor",
        "AHU_Average_Exhaust_Air_Static_Pressure_Sensor" ;
    ex:hasTag <http://example.org/chunktograph#tag:Air>,
        <http://example.org/chunktograph#tag:Sensor>,
        <http://example.org/chunktograph#tag:Temperature> ;
    ex:measures ex:Air,
        ex:Temperature ;
    owl:equivalentClass ex:Average_Exhaust_Air_Static_Pressure_Sensor .

